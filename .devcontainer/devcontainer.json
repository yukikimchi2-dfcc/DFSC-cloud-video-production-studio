{
  "name": "Cloud Video Production Studio",
  "build": { "dockerfile": "../Dockerfile", "context": ".." },
  "workspaceFolder": "/studio",
  "workspaceMount": "source=${localWorkspaceFolder},target=/studio,type=bind",
  "postCreateCommand": "python3 -m pip install -e . && studio audit --offline",
  "hostRequirements": { "cpus": 4, "memory": "16gb", "storage": "32gb" },
  "secrets": {
    "STUDIO_DRIVE_CREDENTIALS_JSON": { "description": "Google service-account JSON (contents). Written to secrets/drive.service-account.json on start." },
    "ANTHROPIC_API_KEY": { "description": "Optional: AI segment scoring with Claude." }
  },
  "postStartCommand": "bash .devcontainer/write-secrets.sh",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "anthropic.claude-code"]
    }
  }
}
